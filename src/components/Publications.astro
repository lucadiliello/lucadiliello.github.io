---
import { siteConfig } from "../config";
const hasPublications = siteConfig.publications && siteConfig.publications.length > 0;
---

{
  hasPublications && (
    <section id="publications" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-2xl sm:text-3xl md:text-4xl xl:text-5xl font-bold text-gray-900">
              Selected Publications
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.publications.map((publication) => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">
                    <div>
                      <h3 class="text-lg sm:text-xl font-semibold text-gray-900">
                        <a href={publication.link} target="_blank" rel="noopener noreferrer">{publication.name}</a>
                      </h3>
                      <p
                        class="text-base sm:text-lg"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {publication.conference}
                      </p>
                    </div>
                  </div>
                  <p class={`text-base sm:text-lg text-gray-600 leading-relaxed`}>
                    {publication.abstract}
                  </p>
                  
                  <ul class="space-y-2">
                      {publication.notes && publication.notes.map((note) => (
                        <p class={`text-base sm:text-lg text-gray-600 leading-relaxed`}><b>Notes:</b></p>
                        <li class="flex items-start">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
                          <span class="text-sm sm:text-base text-gray-600">
                            <span set:html={note} />
                          </span>
                        </li>
                      ))}
                    </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}


