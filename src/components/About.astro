---
import { siteConfig } from "../config";
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl xl:text-5xl font-bold text-gray-900">
          About Me
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
      </div>

      <div class="lg:col-span-8 space-y-8">
        <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600">
          {siteConfig.aboutMe}
        </p>

        <b class="text-md sm:text-l md:text-xl leading-relaxed text-gray-600">Frameworks</b>

        <div class="pt-4">
          <div class="flex flex-wrap gap-3">
            {
              siteConfig.frameworks.map((framework) => (
                <span class="px-3 sm:px-4 py-1.5 sm:py-2 bg-gray-100 text-gray-800 rounded-full text-sm sm:text-base md:text-lg font-medium hover:bg-gray-200 transition-colors duration-200">
                  {framework}
                </span>
              ))
            }
          </div>
        </div>

        <b class="text-md sm:text-l md:text-xl leading-relaxed text-gray-600">Libraries</b>

        <div class="pt-4">
          <div class="flex flex-wrap gap-3">
            {
              siteConfig.libraries.map((library) => (
                <span class="px-3 sm:px-4 py-1.5 sm:py-2 bg-gray-100 text-gray-800 rounded-full text-sm sm:text-base md:text-lg font-medium hover:bg-gray-200 transition-colors duration-200">
                  {library}
                </span>
              ))
            }
          </div>
        </div>

        <b class="text-md sm:text-l md:text-xl leading-relaxed text-gray-600">Platforms</b>

        <div class="pt-4">
          <div class="flex flex-wrap gap-3">
            {
              siteConfig.platforms.map((platform) => (
                <span class="px-3 sm:px-4 py-1.5 sm:py-2 bg-gray-100 text-gray-800 rounded-full text-sm sm:text-base md:text-lg font-medium hover:bg-gray-200 transition-colors duration-200">
                  {platform}
                </span>
              ))
            }
          </div>
        </div>


      </div>
    </div>
  </div>
</section>
